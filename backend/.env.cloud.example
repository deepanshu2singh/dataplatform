# Copy values into backend hosting settings; never put this secret in VITE_*.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PERCENT_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_USE_NULL_POOL=true
SECRET_KEY=replace-with-a-long-random-production-secret
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
FRONTEND_URL=https://YOUR_FRONTEND_HOST
STORAGE_BACKEND=supabase
SUPABASE_URL=https://ckjkgsojwtzbiyqxbtdx.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_BUCKET=datasets
UPLOAD_DIR=/tmp/dataplatform-uploads
MAX_UPLOAD_SIZE=50000000
SQL_ECHO=false
# Use a same-origin frontend /api proxy; cross-site cookies need a separate review.

# Conservative 50,000,000-byte cap fits the reported 50 MB bucket limit.
# Supabase project region: London; Vercel backend function region: lhr1.
