# Copy this file to production.env or use scripts/create-production-env.ps1.
# Never commit production.env.
#
# FRONTEND_URL must be the exact external HTTPS origin seen by the browser.
# The placeholder below is enough for local topology/health testing only.
FRONTEND_URL=https://app.example.test

# Generate unique high-entropy values. Do not reuse development credentials.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-secret
SECRET_KEY=replace-with-a-unique-high-entropy-secret-at-least-32-characters

# Bind the application only to loopback by default. A host-level TLS reverse
# proxy can then publish HTTPS without exposing this HTTP listener directly.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO

# Phase 8F.7 production resource governance
# Safe defaults validated on the current Docker Desktop host.
# Override only when deploying to a differently sized host.

POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_PIDS_LIMIT=128

MIGRATE_CPUS=1.0
MIGRATE_MEMORY_LIMIT=384m
MIGRATE_PIDS_LIMIT=64

BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=1536m
BACKEND_PIDS_LIMIT=128

FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_PIDS_LIMIT=64
